rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Isolated workspace inspection photo storage
    match /workspaces/{workspaceId}/inspections/{inspectionId}/{photoId} {
      // Must be authenticated
      allow read: if request.auth != null;

      // Must be authenticated, valid image MIME type, and max 10MB
      allow write: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      // Allow deletion for authenticated inspection cleanup
      allow delete: if request.auth != null;
    }

    // Explicitly deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
