rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid ||
          (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members)
        )
      );
    }

    function isWorkspaceOwner(workspaceId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
      );
    }

    // Health check path restricted to authenticated users only - NO public reads
    match /test/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Workspaces collection with RBAC
    match /workspaces/{workspaceId} {
      // Workspace members can read only their own workspace document
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (request.auth.uid in resource.data.members)
      );

      // Authenticated users can create a workspace where they are owner
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120;

      // Only the workspace owner can update workspace details; ownership cannot be hijacked
      allow update: if isWorkspaceOwner(workspaceId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 120;

      // Only the workspace owner can delete a workspace
      allow delete: if isWorkspaceOwner(workspaceId);

      // Inspections under workspace (isolated per workspace)
      match /inspections/{inspectionId} {
        allow read: if isWorkspaceMember(workspaceId);

        allow create: if isWorkspaceMember(workspaceId) &&
          request.resource.data.trackingCode is string &&
          request.resource.data.vehicle is map &&
          request.resource.data.revision is number;

        allow update: if isWorkspaceMember(workspaceId) &&
          request.resource.data.revision >= resource.data.revision;

        allow delete: if isWorkspaceMember(workspaceId);

        // Photo evidence metadata subcollection
        match /photos/{photoId} {
          allow read: if isWorkspaceMember(workspaceId);

          allow create, update: if isWorkspaceMember(workspaceId) &&
            request.resource.data.fileSize is number &&
            request.resource.data.fileSize <= 10485760 &&
            request.resource.data.mimeType.matches('image/(jpeg|png|webp)');

          allow delete: if isWorkspaceMember(workspaceId);
        }
      }
    }

    // Default deny all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
